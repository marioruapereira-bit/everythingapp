# Port for the web app
PORT=3000

# "mock" (default, sample data) or "google" (Google Calendar + Gmail)
PROVIDER=mock

# Google OAuth credentials, only needed when PROVIDER=google.
# Scopes: calendar.readonly and gmail.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Alerts
ALERT_LEAD_MINUTES=30
# Comma-separated, case-insensitive substrings matched against the sender
VIP_SENDERS=
# Comma-separated, matched against email subjects and snippets
ALERT_KEYWORDS=urgent,invoice,deadline,action required

# Default newsfeed topics (used until you edit them in the app)
NEWS_TOPICS=artificial intelligence,personal finance
